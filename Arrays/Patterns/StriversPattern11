package Patterns;

public class Pattern11 {

	public static void main(String[] args) {

     int n = 5 ;
     
     for( int i = 1 ; i <= n ; i++)
     {
    	    
    	 boolean sw = false ;
    	 
    	 if(i % 2 != 0 ) sw = true ;
    	 
    	 for( int j = 1 ; j <= i ; j++ )
    	 {

               if(sw) System.out.print(" "+1);
               else System.out.print(" "+0);
               
    		   
    		   sw= !sw ;
    	 }
    	 System.out.println() ;
     }
		
		

	}

}
