package Patterns;

public class Pattern9 {

	public static void main(String[] args) {

     
		int n = 7 ; 
		
		for ( int i = 0 ; i <= n ; i++ )
		{
			
			for( int sp = 0 ; sp < n - i ; sp++)
			{
				System.out.print(" ");
			}
			
			for( int s = 0 ; s < i ; s++)
			{
				System.out.print(" *");
			}
			
			System.out.println();
			
			
			
		}
		
		for ( int i = n ; i >= 0 ; i-- )
		{
			
			for( int sp = n - i ; sp > 0 ; sp-- )
			{
				System.out.print(" ");
			}
			
			for( int s = i ; s > 0 ; s--)
			{
				System.out.print(" *");
			}
			
			System.out.println();
			
			
			
		}


	}

}
