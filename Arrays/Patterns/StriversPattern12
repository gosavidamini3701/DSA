package Patterns;

public class Pattern12 {

	public static void main(String[] args) {

     
		int n = 5 ;
		
		for( int i = 1 ; i <=  n ; i++ )
		{
			 
			
                   for( int  k= 1 ; k <= i ; k++)
                   {
                	   System.out.print(k);
                   }
                   
                   for( int s =(  (2 * n ) -  (2 * i)); s > 0  ; s-- )
                   {
                	   System.out.print(" ");
                   }

                   
                   for( int  k= i ; k >= 1  ; k--)
                   {
                	   System.out.print(k);
                   }
			
			
			System.out.println();
		}
		
		

	}

}
