package Patterns;

public class Pattern8 {

	public static void main(String[] args) {

       int  n = 7 ;
       
       for ( int i = n ; i > 0 ; i-- )
       {
    	   for( int s = n - i ; s > 0 ; s--)
    	   {
    		   System.out.print(" ");
    	   }
    	   
    	   for( int j = i ; j > 0 ; j-- )
    	   {
    		     System.out.print(" *");
    	   }
    	   
    	   System.out.println();
    	   
       }
       
		
		

	}

}
