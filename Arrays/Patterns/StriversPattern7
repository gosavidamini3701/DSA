package Patterns;

public class Pattern7 {

	public static void main(String[] args) {

      int n  =  5 ; 
      
      
    	  for( int j = 1 ; j <= n ; j++)
    	  {
    		    for ( int s = 1 ; s <= n - j ; s++ )
    		    {
    		    	System.out.print("  ");
    		    }
    		    
    		    for( int f = 1 ; f <= j ; f++)
    		    {
    		    	System.out.print("  * ");
    		    }
    		    
    		    System.out.println() ;
    	  }
    	  
    	 
    	  
      

	}

}
