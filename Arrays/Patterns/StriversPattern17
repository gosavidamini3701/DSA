package Patterns;

public class Pattern17 {

    public static void main(String[] args) {

        int n = 5;
        int sp = n - 1;

        for (int i = 1; i <= n; i++) {

            for (int k = 1; k <= sp; k++) {
                System.out.print(" ");
            }

            char ch = 'A';

            
            for (int j = 1; j <= i; j++) {
                System.out.print(ch++);
            }



            ch -= 2;

            for (int j = 1; j < i; j++) {
                System.out.print(ch--);
            }

            sp--;

            System.out.println();
        }
    }
}
