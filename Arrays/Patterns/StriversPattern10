package Patterns;

public class Pattern10 {

	public static void main(String[] args) {

     
		int n = 5 ; 
		
		for( int i =  1 ; i <= (2 * n ) - 1 ; i++ )
		{
			 int st = i ; 
			 if( i >  n ) st = ( 2 * n ) - i ;
			 
			 for( int k = 1 ; k <= st ; k++ )
			 {
				 System.out.print("*");
			 }
			 
			 System.out.println();
		}

	}

}
